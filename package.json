{
  "name": "duna-boats",
  "version": "1.0.0",
  "private": true,
  "description": "Duna Haj\u00f3k / Duna Boats \u2014 Phase One digital experience.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node scripts/check-glsl.mjs && tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "vessel": "node --experimental-strip-types --import ./scripts/pxl/ts-resolve.mjs scripts/pxl/validate-vessel.mjs",
    "pxl": "python3 scripts/pxl/build_pxl.py --preview && npm run pxl:blender && node scripts/pxl/compress-pxl.mjs && node scripts/pxl/build-pxl-media.mjs",
    "pxl:blender": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" -b --python scripts/pxl/pxl_blender.py",
    "model": "node scripts/pxl/validate-model.mjs",
    "duna": "node scripts/pxl/build-duna-trace.mjs",
    "trace": "node --experimental-strip-types --import ./scripts/pxl/ts-resolve.mjs scripts/pxl/trace-proof.mjs",
    "reference": "node scripts/pxl/reference-qa.mjs",
    "upper": "node scripts/pxl/measure-upper.mjs --write",
    "landmarks": "node --experimental-strip-types --import ./scripts/pxl/ts-resolve.mjs scripts/pxl/landmarks.mjs",
    "sheet": "node scripts/pxl/comparison-sheet.mjs",
    "crops": "node scripts/pxl/detail-crops.mjs",
    "paint": "node scripts/pxl/paint-line-qa.mjs",
    "upholstery": "node scripts/pxl/upholstery-qa.mjs",
    "upholstery:trace": "node scripts/pxl/upholstery-trace.mjs",
    "upholstery:sheet": "node scripts/pxl/upholstery-sheet.mjs",
    "sink": "node scripts/pxl/qa-sink.mjs",
    "test": "node scripts/pxl/test-configurator.mjs",
    "qa": "npm run typecheck && npm run model && npm run vessel && npm run landmarks && npm run upholstery && npm test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.180.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3"
  }
}
